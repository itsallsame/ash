{
  "contract": "ash-app/1",
  "id": "vitals",
  "name": "她的状态",
  "version": "1.0.0",
  "icon": "icon.svg",
  "summary": "她自己的运行状态：忙不忙、占了多少内存、今天做了多少事，哪里不对劲，以及要不要重启大脑",
  "role": "主人问「你怎么样」「为什么慢」「手机发热」时用它：vitals.status 是她此刻的状态和最近的告警，vitals.day 是今天和最近 24 小时，vitals.restart 重启大脑（先问主人）",
  "publisher": "ash",
  "server": { "command": "node", "args": ["server.mjs"] },
  "data_dir": "data",
  "surfaces": [
    { "id": "home", "title": "状态", "resource": "ui://vitals/home" },
    { "id": "alert", "title": "告警", "resource": "ui://vitals/alert" }
  ],
  "cards": [
    { "id": "status", "title": "她的状态", "size": "4x2", "tool": "vitals.card", "refresh_min": 15 }
  ],
  "needs": [
    { "member": "service:health", "words": ["status", "recent"], "why": "看她此刻的运行状况和最近的告警" },
    { "member": "service:cost", "words": ["usage.get"], "why": "算今天想了几次、花了多少" },
    { "member": "service:history", "words": ["activity.count"], "why": "数今天做了几件事" },
    { "member": "service:admin", "words": ["status", "checkup"], "why": "看她是不是被暂停了、连着几台设备，以及手机报来的体检摘要" },
    { "member": "service:devices", "words": ["list"], "why": "告警里写出是哪台设备" },
    { "member": "service:host", "words": ["restart"], "why": "你点了「重启大脑」并确认之后重启它" },
    { "member": "service:widgets", "words": ["widget.card.put"], "why": "把她的状态画在桌面小组件上" }
  ]
}

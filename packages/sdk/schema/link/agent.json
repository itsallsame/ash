{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ash-link/1 agent frame",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "t": {
          "const": "agent"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "op": {
          "type": "string",
          "enum": [
            "agent.start",
            "agent.stop",
            "agent.list",
            "session.get",
            "session.set",
            "session.new",
            "session.reload",
            "session.compact",
            "send",
            "followup",
            "steer",
            "inject",
            "interrupt",
            "restart",
            "configure",
            "config.get",
            "plugins"
          ]
        }
      },
      "required": [
        "t",
        "id",
        "op"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "const": "agent"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "op_result": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "type": "boolean"
        },
        "result": {},
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "detail": {},
            "recovery_hint": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "t",
        "id",
        "op_result",
        "ok"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "const": "agent"
        },
        "event": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "t",
        "event"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "const": "agent"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outbound": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "t",
        "id",
        "outbound"
      ]
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "const": "agent"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outbound_result": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "t",
        "id",
        "outbound_result"
      ]
    }
  ]
}

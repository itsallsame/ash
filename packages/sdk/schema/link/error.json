{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ash-link/1 error frame",
  "type": "object",
  "properties": {
    "t": {
      "const": "error"
    },
    "code": {
      "type": "string",
      "enum": [
        "bad_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "denied",
        "cancelled",
        "timeout",
        "offline",
        "result_unknown",
        "conflict",
        "too_large",
        "unavailable",
        "failed",
        "internal"
      ]
    },
    "message": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "t",
    "code",
    "message"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ash-link/1 call frame",
  "type": "object",
  "properties": {
    "t": {
      "const": "call"
    },
    "ch": {
      "const": "device"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "args": {
      "type": "object",
      "properties": {}
    },
    "caller": {
      "type": "object",
      "properties": {
        "member": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "turn": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "member",
        "label"
      ],
      "additionalProperties": false
    },
    "deadline": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "t",
    "ch",
    "id",
    "capability",
    "args",
    "caller",
    "deadline"
  ],
  "additionalProperties": false
}

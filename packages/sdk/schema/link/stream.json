{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ash-link/1 stream frame",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "t": {
          "const": "stream"
        },
        "sid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "op": {
          "const": "open"
        },
        "ch": {
          "type": "string",
          "enum": [
            "device",
            "human",
            "agent"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "t",
        "sid",
        "op",
        "ch"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "const": "stream"
        },
        "sid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "op": {
          "const": "data"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "maxLength": 349528
        }
      },
      "required": [
        "t",
        "sid",
        "op",
        "seq",
        "b64"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "const": "stream"
        },
        "sid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "op": {
          "const": "end"
        }
      },
      "required": [
        "t",
        "sid",
        "op"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "t": {
          "const": "stream"
        },
        "sid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "op": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "bad_request",
            "unauthorized",
            "forbidden",
            "not_found",
            "denied",
            "cancelled",
            "timeout",
            "offline",
            "result_unknown",
            "conflict",
            "too_large",
            "unavailable",
            "failed",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "t",
        "sid",
        "op",
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  ]
}

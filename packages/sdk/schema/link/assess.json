{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ash-link/1 assess frame",
  "type": "object",
  "properties": {
    "t": {
      "const": "assess"
    },
    "ch": {
      "const": "device"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "args": {
      "type": "object",
      "properties": {}
    }
  },
  "required": [
    "t",
    "ch",
    "id",
    "capability",
    "args"
  ],
  "additionalProperties": false
}

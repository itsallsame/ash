<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Part of Ash itself: the owner enables Ash in Android accessibility settings. -->
        <service
            android:name="ai.ash.screen.a11y.A11yService"
            android:process=":screen"
            android:exported="false"
            android:label="@string/ash_accessibility_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config" />
        </service>
        <!-- Internal bridge; no other installed app can bind to this service. -->
        <service android:name="ai.ash.screen.BridgeService" android:process=":screen" android:exported="false" />
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Two themes on purpose: a WebView reports prefers-color-scheme from the theme's isLightTheme
         only (it ignores the system night mode), so HomeActivity picks one by the system setting.
         Their colours are the design's (ash_bg has a night variant, and the system setting is what picks the theme). -->
    <style name="Ash.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ash_bg</item>
        <item name="android:statusBarColor">@color/ash_bg</item>
        <item name="android:navigationBarColor">@color/ash_bg</item>
    </style>
    <style name="Ash.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ash_bg</item>
        <item name="android:statusBarColor">@color/ash_bg</item>
        <item name="android:navigationBarColor">@color/ash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- One line on the Ash widget: something the owner has not seen yet. -->
    <style name="WidgetItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_fg</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
